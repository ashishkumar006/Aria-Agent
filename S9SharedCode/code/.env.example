# Aria agent env — SECRET-FREE by design.
# ALL third-party credentials live in llm_gatewayV9/.env (see
# llm_gatewayV9/.env.example). The agent only needs to know WHERE the
# gateway is, plus local (non-secret) behaviour flags. Copy this file to
# .env and adjust; every integration tool fails soft if the gateway side
# is not configured.

# Where the gateway lives (agent -> gateway for LLM, channels, voice, spend).
LLM_GATEWAY_V9_URL=http://localhost:8109

# Optional bearer gate: when set, every /api/* route except /api/health
# requires `Authorization: Bearer …` (the console sends it from
# Settings > API Token).
ARIA_API_TOKEN=

# Bind address for the agent (loopback by default; never 0.0.0.0 unless you
# mean it — the API has no per-user auth beyond the bearer token above).
ARIA_HOST=127.0.0.1

# Computer-use opt-in (default OFF; dry-run describes, never executes).
COMPUTER_USE_ENABLED=false
COMPUTER_USE_MODE=dry-run
# Optional path allow/deny lists for computer-use (comma-separated globs).
COMPUTER_USE_ALLOW=
COMPUTER_USE_DENY=

# Optional Prefab.cloud key for live flag sync (Apps > Flags works locally
# without it).
PREFAB_API_KEY=

# Optional Guardian Open Platform key (free 5k/day) — last-resort news
# source when GDELT throttles and HN has nothing.
GUARDIAN_API_KEY=

# Optional contact for the OpenAlex polite pool (separate, higher rate
# limits). Anonymous calls share tighter limits and datacenter egress IPs
# get throttled hard — without this, openalex_search may 429 under load
# (it then fails soft and the researcher moves on).
OPENALEX_MAILTO=

# Telegram notifications for completed agent tasks (the bot token itself is
# gateway-side; these only control whether and where the agent notifies).
AGENT_TELEGRAM_NOTIFY=false
AGENT_NOTIFY_CHAT_ID=

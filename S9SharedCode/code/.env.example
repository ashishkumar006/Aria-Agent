TAVILY_API_KEY=tvly-dev-...

# ── Session 9 integration tools (all optional; tools fail-soft if unset) ──
# Telegram: create a bot via @BotFather, copy the token below.
TELEGRAM_BOT_TOKEN=
# Google Calendar: an OAuth2 access token with the calendar.events scope.
GOOGLE_CALENDAR_TOKEN=

# ── Tier-1 integrations (computer-use / general assistant) ──
# GitHub: a fine-grained or classic personal access token (repo, read:org).
GITHUB_TOKEN=
# Slack: a bot token from api.slack.com (xoxb-...). Needs chat:write scope.
SLACK_BOT_TOKEN=
# Notion: an internal integration secret (secret_...) from notion.so/my-integrations.
NOTION_TOKEN=
# Gmail (OAuth2, no SMTP / app password). GMAIL_TOKEN is an access token with
# the gmail.send AND gmail.readonly scopes (request both together). It expires
# ~hourly; run gmail_refresh_token() (or set the keys below) to mint a new one.
GMAIL_TOKEN=
# Optional: long-lived refresh credentials so gmail_refresh_token() can renew
# GMAIL_TOKEN automatically. From a Google Cloud OAuth2 client (Desktop type).
GMAIL_REFRESH_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=


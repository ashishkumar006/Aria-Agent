# Aria gateway env — ALL secrets live HERE (never commit this file).
# Copy to .env and fill in. Missing keys simply disable that provider /
# channel (fail-soft everywhere); `uv run python check_keys.py` shows what
# is set (names only, never values).

# ── LLM workers (at least one required) ──
# Multi-key pools: keep SINGULAR for key #1, add MORE keys comma- (or space-)
# separated in the PLURAL twin. Each key becomes its own pool member
# (gemini, gemini-2, …) with independent rate state — a 429 on one key
# fails over to the next automatically. First key keeps the canonical name
# so pins/shortcuts keep working; siblings are pinned as provider=gemini-2.
GEMINI_API_KEY=
#GEMINI_API_KEYS=key2,key3
#GEMINI_MODEL=gemini-2.5-flash
#GEMINI_35_LITE_MODEL=gemini-3.5-flash-lite
NVIDIA_API_KEY=
#NVIDIA_API_KEYS=key2,key3
#NVIDIA_MODEL=deepseek-ai/deepseek-v3.2
GROQ_API_KEY=
#GROQ_API_KEYS=key2,key3
#GROQ_MODEL=openai/gpt-oss-120b
CEREBRAS_API_KEY=
#CEREBRAS_API_KEYS=key2,key3
#CEREBRAS_MODEL=zai-glm-4.7
OPEN_ROUTER_API_KEY=
#OPEN_ROUTER_API_KEYS=key2,key3
#OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
GITHUB_ACCESS_TOKEN=
#GITHUB_ACCESS_TOKENS=token2,token3
#GITHUB_MODEL=openai/gpt-4.1-mini
KILO_API_KEY=
#KILO_API_KEYS=key2,key3
#KILO_MODEL=tencent/hy3:free
#KILO_BASE_URL=https://api.kilo.ai/api/gateway
#OLLAMA_MODEL=
#ENABLE_OLLAMA_LLM=false
#OLLAMA_URL=http://localhost:11434
#LLM_ORDER=gemini35lite,gemini,nvidia,groq,cerebras,openrouter,github,kilo
#ROUTER_ORDER=cerebras,groq,nvidia,github
#GATEWAY_V9_PORT=8109
# Gemini-only mode: only gemini/gemini35lite members (and their key-pool
# siblings) are wired; every other provider key is ignored and the router
# pool empties (tier falls back to the token-count rule). Reversible.
#GATEWAY_GEMINI_ONLY=true

# ── Embeddings ──
#EMBED_OLLAMA_MODEL=nomic-embed-text
#EMBED_ORDER=ollama
#OLLAMA_URL=http://localhost:11434

# ── Channel adaptors (Tier-1, migrated from the agent) ──
# Telegram: @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Gmail OAuth2 (gmail.send + gmail.readonly). Run gmail_oauth_setup.py once.
GMAIL_TOKEN=
GMAIL_REFRESH_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Google Calendar (OAuth, calendar.events scope). Mint via:
#   cd llm_gatewayV9 && uv run python calendar_oauth_setup.py
# (needs the client pair below first; writes TOKEN + REFRESH_TOKEN).
GOOGLE_CALENDAR_TOKEN=
#GOOGLE_CALENDAR_REFRESH_TOKEN=
#GOOGLE_CALENDAR_CLIENT_ID=
#GOOGLE_CALENDAR_CLIENT_SECRET=
# GitHub personal access token (repo, read:org)
GITHUB_TOKEN=
# Slack bot token (xoxb-... long-lived, or rotating xoxe-... with token rotation ON)
SLACK_BOT_TOKEN=
#SLACK_SIGNING_SECRET=
# Rotation triple (ONLY needed when the Slack app has token rotation ON —
# then the access token dies every 12h and auto-refreshes from these):
#SLACK_REFRESH_TOKEN=
#SLACK_CLIENT_ID=
#SLACK_CLIENT_SECRET=
# Notion internal integration secret (secret_...)
NOTION_TOKEN=
# Web search chain: Tavily → Brave → DDG → Marginalia.
# Tavily (paid) and Brave (free 2k/mo key) are optional and skipped when
# unset. DDG needs no key. Marginalia uses the shared `public` key unless
# MARGINALIA_API_KEY holds a free personal key (email the project for one).
TAVILY_API_KEY=
BRAVE_API_KEY=
MARGINALIA_API_KEY=

# ── New channels (scaffold phase — keys activate as each wires up) ──
#DISCORD_BOT_TOKEN=
#MATRIX_HOMESERVER=
#MATRIX_USER=
#MATRIX_PASSWORD=
#LINE_CHANNEL_SECRET=
#LINE_ACCESS_TOKEN=
#WEBHOOK_SECRET=
#WEBHOOK_OUT_URL=
#SIGNAL_NUMBER=
#SIGNAL_DATA_DIR=
#IMAP_HOST=
#IMAP_USER=
#IMAP_PASS=
#SMTP_HOST=
#SMTP_USER=
#SMTP_PASS=
#TWILIO_SID=
#TWILIO_AUTH=
#TWILIO_FROM=
#TWILIO_WEBHOOK_URL=
#WHATSAPP_FROM=
#TEAMS_APP_ID=
#TEAMS_APP_PASSWORD=
#TEAMS_TENANT=
#WA_TOKEN=
#WA_PHONE_ID=
#WA_VERIFY_TOKEN=
#TWILIO_VOICE_FROM=
#VOICE_WS_URL=

# ── Voice services (gateway-owned models) ──
#KOKORO_MODEL=./models/kokoro-v1.0.onnx
#KOKORO_VOICES=./models/voices-v1.0.bin
#STT_MODEL=base
#STT_DEVICE=cpu
#STT_COMPUTE=int8

# ── Policy / control ──
# Policy engine starts dry-run (report-only) regardless of this file.
#GATEWAY_TRUST_ALL_LOCAL=true
# Kill switch is DISABLED unless explicitly armed:
#ARIA_ENABLE_KILL=1
#GLC_KILL_ALLOW_REMOTE=1
